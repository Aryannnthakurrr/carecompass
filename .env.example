SARVAM_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Sign-in: Google OAuth web client ID (authorised JS origin http://localhost:5173)
GOOGLE_CLIENT_ID=
# Phone OTP via httpSMS (Android phone as SMS gateway): key from https://httpsms.com/settings,
# FROM = that phone's number in E.164, e.g. +919876543210
# Phone OTP: Twilio Verify is used when all three are set (else httpSMS, else OTP_DEV_MODE=1)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
HTTPSMS_API_KEY=
HTTPSMS_FROM=
# 1 = without httpSMS, OTP codes are logged and shown in the UI instead (demo only)
OTP_DEV_MODE=
